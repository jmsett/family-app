{
  "name": "family-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "build:pages": "VITE_BASE_PATH=/family-app/ npm run build && tsx scripts/prepare-pages.ts",
    "preview:pages": "tsx scripts/preview-pages.ts",
    "start": "tsx apps/api/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build:pages && playwright test --config playwright.pwa.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run format:check"
  },
  "dependencies": {
    "@family/domain": "*",
    "@family/shared": "*",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.0.0",
    "lightweight-charts": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
